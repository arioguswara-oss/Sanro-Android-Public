  "components": {
    "securitySchemes": {
      "deviceAccess": {
        "type": "http",
        "scheme": "DPoP",
        "description": "Opaque access token bound to same DPoP key; proof header also required."
      }
    },
    "schemas": {
      "PublicJwk": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kty",
          "crv",
          "x",
          "y"
        ],
        "properties": {
          "kty": {
            "type": "string",
            "enum": [
              "EC"
            ]
          },
          "crv": {
            "type": "string",
            "enum": [
              "P-256"
            ]
          },
          "x": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "y": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          }
        }
      },
      "ChallengeRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "purpose",
          "public_jwk"
        ],
        "properties": {
          "purpose": {
            "type": "string",
            "enum": [
              "LOGIN",
              "SESSION",
              "REFRESH",
              "ACTIVATE",
              "LEASE",
              "RECOVER",
              "CONFIRM_RECOVERY",
              "LOGOUT"
            ]
          },
          "public_jwk": {
            "$ref": "#/components/schemas/PublicJwk"
          }
        }
      },
      "Challenge": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "challenge_id",
          "nonce",
          "server_time",
          "expires_at"
        ],
        "properties": {
          "challenge_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "nonce": {
            "type": "string",
            "minLength": 32
          },
          "server_time": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "email",
          "password",
          "challenge_id"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "writeOnly": true
          },
          "challenge_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "RefreshRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "refresh_token",
          "challenge_id"
        ],
        "properties": {
          "refresh_token": {
            "type": "string",
            "minLength": 32,
            "maxLength": 4096,
            "writeOnly": true
          },
          "challenge_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "CommandRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "challenge_id"
        ],
        "properties": {
          "challenge_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "RecoveryRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "email",
          "password",
          "challenge_id"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "writeOnly": true
          },
          "challenge_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "ConfirmRecoveryRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "recovery_id",
          "confirm_revoke",
          "challenge_id"
        ],
        "properties": {
          "recovery_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "confirm_revoke": {
            "const": true
          },
          "challenge_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "Context": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contract_version",
          "authenticated",
          "account_id",
          "product_account_id",
          "tenant_id",
          "tenant_code",
          "device_id",
          "device_jkt",
          "session_id",
          "authorization_epoch",
          "authority_revision",
          "server_time",
          "account_status",
          "tenant_status",
          "product_status",
          "subscription_status",
          "plan",
          "storage_mode",
          "trial_started_at",
          "trial_expires_at",
          "entitlement_expires_at",
          "access_mode",
          "permissions",
          "history_permissions"
        ],
        "properties": {
          "contract_version": {
            "type": "string",
            "enum": [
              "1"
            ]
          },
          "authenticated": {
            "const": true
          },
          "account_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "product_account_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "tenant_id": {
            "type": "string",
            "pattern": "^ST[0-9]{5,}$"
          },
          "tenant_code": {
            "type": "string",
            "pattern": "^SR[0-9]{5,}$"
          },
          "device_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "device_jkt": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "session_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "authorization_epoch": {
            "type": "integer",
            "minimum": 1
          },
          "authority_revision": {
            "type": "integer",
            "minimum": 1
          },
          "server_time": {
            "type": "string",
            "format": "date-time"
          },
          "account_status": {
            "type": "string",
            "enum": [
              "ACTIVE"
            ]
          },
          "tenant_status": {
            "type": "string",
            "enum": [
              "ACTIVE"
            ]
          },
          "product_status": {
            "type": "string",
            "enum": [
              "ACTIVE"
            ]
          },
          "subscription_status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "EXPIRED"
            ]
          },
          "plan": {
            "type": "string",
            "enum": [
              "FREE",
              "STARTER",
              "PRO"
            ]
          },
          "storage_mode": {
            "type": "string",
            "enum": [
              "LOCAL_ONLY"
            ]
          },
          "trial_started_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "trial_expires_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "entitlement_expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "access_mode": {
            "type": "string",
            "enum": [
              "READ_WRITE",
              "READ_ONLY"
            ]
          },
          "permissions": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "product.write",
                "cart.write",
                "stock.write",
                "sale.create"
              ]
            }
          },
          "history_permissions": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "history.read",
                "stock.read",
                "report.read",
                "history.export",
                "receipt.reprint"
              ]
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "subscription_status": {
                  "const": "EXPIRED"
                }
              }
            },
            "then": {
              "properties": {
                "access_mode": {
                  "const": "READ_ONLY"
                },
                "permissions": {
                  "maxItems": 0
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "access_mode": {
                  "const": "READ_ONLY"
                }
              }
            },
            "then": {
              "properties": {
                "permissions": {
                  "maxItems": 0
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "plan": {
                  "const": "FREE"
                }
              }
            },
            "then": {
              "properties": {
                "trial_started_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "trial_expires_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "plan": {
                  "enum": [
                    "STARTER",
                    "PRO"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "access_mode": {
                  "const": "READ_ONLY"
                },
                "permissions": {
                  "maxItems": 0
                }
              }
            }
          }
        ]
      },
      "TokenPair": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "access_token",
          "token_type",
          "expires_in",
          "refresh_token",
