{
  "openapi": "3.1.0",
  "info": {
    "title": "SANRO POS2 Mobile Auth \u2014 PROPOSED, NOT DEPLOYED",
    "version": "0.1.0-proposal",
    "description": "Docs-only contract candidate for isolated staging. No adapter is implemented. Operational activation is FREE only. Recognized paid plans may authenticate for read-only history; paid operational modes are outside this adapter."
  },
  "servers": [
    {
      "url": "https://pos2-mobile-staging.invalid/api/mobile/v1",
      "description": "Placeholder, deliberately non-routable; Owner must assign isolated staging"
    }
  ],
  "paths": {
    "/challenges": {
      "post": {
        "operationId": "challenges_post",
        "summary": "Unauthenticated nonce issuance; no account state",
        "security": [],
        "responses": {
          "200": {
            "description": "Success; no-store. See cross-field authorization constraints in PROPOSAL.md.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChallengeResponse"
                }
              }
            }
          },
          "default": {
            "description": "Redacted fail-closed error. Mapping in acceptance.feature / PROPOSAL.md.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChallengeRequest"
              }
            }
          }
        }
      }
    },
    "/login": {
      "post": {
        "operationId": "login_post",
        "summary": "Authenticate; never automatically acquire operational slot",
        "security": [],
        "responses": {
          "200": {
            "description": "Success; no-store. See cross-field authorization constraints in PROPOSAL.md.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenPairResponse"
                }
              }
            }
          },
          "default": {
            "description": "Redacted fail-closed error. Mapping in acceptance.feature / PROPOSAL.md.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "DPoP",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 32
            },
            "description": "RFC 9449 profile, ES256; nonce and jti replay checked. ath required with access token. No Bearer fallback."
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 128
            },
            "description": "Same logical command keeps key; retries require fresh proof/nonce. Bound response replay window 10 minutes."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        }
      }
    },
